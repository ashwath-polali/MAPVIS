# Copy to .env and fill in. Never commit the copy: .gitignore and .vercelignore
# both stop it, and a real environment variable always beats a line in this file.

# Postgres. Direct for migrations, pooled for the app.
DATABASE_URL=
DATABASE_POOLED_URL=

# S3-compatible object storage. Any of B2, R2, S3 or MinIO. Leave every line
# blank and the tool falls back to work/.blobs on this machine.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The shared account the import scripts create and every map is owned by.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Local only. Treat an unauthenticated request as this account, so one person on
# one laptop never meets a login screen. Refused wherever a host is detected.
MAPVIS_SOLO=
# Set to 1 to turn the line above off without deleting it.
MAPVIS_NO_SOLO=

# The account that owns the single world row. Unset this and BOOTSTRAP_EMAIL and
# the world gate opens, which is the one-laptop no-login case.
OCEAN_OWNER=

# The linked machine, run with `node server/relay.mjs`. It holds no api key: it
# runs a claude cli already installed on that machine and posts answers back.
MAPVIS_LOCAL_RELAY=
MAPVIS_URL=
MAPVIS_RELAY_TOKEN=
MAPVIS_RELAY_NAME=
MAPVIS_RELAY_CAPS=
# Which model the planner asks for. Optional.
PLANNER_MODEL=

# aes-256-gcm master key for the api-key vault. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_VAULT_SECRET=

# PixelLab. Used when the signed-in account has no key of its own.
PIXELLAB_TOKEN=

# ---- optional, all with working defaults ----
# Where the editor writes bundles. Defaults to work/, or the host's tmp dir.
MAPVIS_WORK=
# Port for the standalone api. `npm run dev` runs the api inside vite on 5274.
MAPVIS_API_PORT=
# Set to 1 to keep the server off local disk entirely.
MAPVIS_NO_DISK=
# Send a session cookie without the Secure flag, for plain-http local testing.
MAPVIS_INSECURE_COOKIE=
# Request budget per ip.
RATE_PER_SEC=
RATE_BURST=
# The python and checkpoint the mask proposer shells out to, if you use it.
MAPVIS_PYTHON=
MAPVIS_SAM_CKPT=
# Monthly ceilings on the bucket, so a loop cannot spend the storage bill.
S3_MAX_OPS=
R2_MONTHLY_READ_LIMIT=
R2_MONTHLY_WRITE_LIMIT=
