{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/work/(.*)", "destination": "/api/index.mjs" },
    { "source": "/((?!api/|work/|assets/).*)", "destination": "/index.html" }
  ],
  "regions": ["pdx1"]
}
