{
  "name": "mapvis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A one-screen tool for drawing walkable ground, elevation levels and occluders onto a painted map.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "api": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
