# --- build output and local state ---
node_modules/
dist/
dist-ssr/
.vite/
.vite-cache/
*.local

# --- maps you author ---
# Everything the editor writes for a map: the source painting, the hand-drawn cut
# and level masks, the generated asset library and the exported bundle. That is
# the author's own work and it belongs to whoever drew it, so it stays on the
# machine that made it. Back it up somewhere private; it is not in this history.
work/
public/work/

# --- environment ---
# Nothing secret is committed. The template, names only and no values, is the one
# env file that ships.
.env
.env.*
!.env.example
.vercel

# --- working notes ---
# Notes and design documents stay on disk. The README and the LICENSE are what
# the repo explains itself with.
*.md
!README.md
docs/

# --- scratch ---
.tmp-*
/out/
/_out/
/_tmp/
/assets/
__pycache__/
*.pyc
.cache/
.DS_Store
